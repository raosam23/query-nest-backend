# Copy this file to .env and replace the placeholder secrets.
# pydantic-settings reads these names. Do not commit a real .env file.

# Async SQLAlchemy URL. The engine logs every statement (echo is always on)
# and does not add ssl=require. Put ssl in the URL when the host requires it.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/querynest

# JWT signing. Login returns this token in JSON.
# Protected routes expect Authorization: Bearer <token>.
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
# When unset, the application defaults to 60.
JWT_EXPIRE_MINUTES=60

# Chat model. app/agents/llm.py builds ChatOpenAI (gpt-4o-mini, temperature 0) at import.
OPENAI_API_KEY=sk-your-key

# Required at import. The search agent constructs TavilySearchResults while the app loads.
TAVILY_API_KEY=tvly-your-key
